# Copy to .env in the project root and fill in. config/settings.py loads
# this file automatically on every run (see _load_env_file) -- a real
# environment variable of the same name still takes precedence over this
# file, so `export ANTHROPIC_API_KEY=...` in your shell still works too.
# Run `chmod 600 .env` after filling it in.

ANTHROPIC_API_KEY=

# Optional overrides -- defaults live in config/settings.py
# HR_AGENT_CONNECTOR=gmail
# GMAIL_CREDENTIALS_PATH=config/credentials.json
# GMAIL_TOKEN_PATH=config/token.json
# GMAIL_PROCESSED_LABEL=HR-Agent-Processed
# GMAIL_REVIEW_LABEL=HR-Agent-NeedsReview
# GMAIL_QUERY=in:inbox -label:HR-Agent-Processed
# GMAIL_MAX_RESULTS=20
# ATTACHMENT_OUTPUT_DIR=output/hr_attachments
# CLAUDE_MODEL=claude-sonnet-5
# HR_AGENT_LOG_PATH=logs/decisions.log
# HR_AGENT_RULES_PATH=config/rules.json
